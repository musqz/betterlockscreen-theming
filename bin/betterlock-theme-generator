#!/usr/bin/env bash

ICON="system-lock-screen"
WORK_DIR="$HOME/.config/betterlockscreen"
THEME_DIR="$WORK_DIR/themes"

mkdir -p "$THEME_DIR"

case "${LANG:0:2}" in
    nl)
        TITLE="Stijl kiezen"
        CHOOSE_STYLE="Selecteer een kleurstijl:"
        SAVE_AS="Opslaan als..."
        ENTER_NAME="Voer een naam in voor het nieuwe thema:"
        THEME_SAVED="Thema opgeslagen als:"
        PREVIEW_TITLE="Themavoorbeeld"
        CANCEL="Annuleren"
        REGENERATE="Opnieuw genereren"
        SAVE="Opslaan"
        WELCOME="Wachtwoord voor $USER"
        VERIFTXT="DNA scannen..."
        WRONGTXT="TOEGANG GEWEIGERD"
        WELCOME_="Inlogtekst"
        VERIFTXT_="Verificatietekst"
        WRONGTXT_="Waarschuwingstekst"
        CHOOSE_TXT="Kies uw tekst"
        loginshadow_="Schaduw inlogvak"
        loginbox_="Achtergrond inlogvak"
        transparent_="Transparante achtergrond (geen schaduw)"
        font_="Lettertype"
        ringcolor_="Ringkleur"
        insidecolor_="Binnenkleur"
        separatorcolor_="Scheidingskleur"
        ringvercolor_="Ringverificatiekleur"
        insidevercolor_="Binnenverificatiekleur"
        ringwrongcolor_="Ringfoutkleur"
        insidewrongcolor_="Binnenfoutkleur"
        timecolor_="Tijdkleur"
        greetercolor_="Begroetingskleur"
        layoutcolor_="Indelingskleur"
        keyhlcolor_="Toetsmarkeringskleur"
        bshlcolor_="Backspacemarkeringskleur"
        verifcolor_="Verificatiekleur"
        wrongcolor_="Foutkleur"
        modifcolor_="Wijzigingskleur"
        bgcolor_="Achtergrondkleur"
        ;;
    pl)
        TITLE="Wybór stylu"
        CHOOSE_STYLE="Wybierz styl kolorów:"
        SAVE_AS="Zapisz jako..."
        ENTER_NAME="Podaj nazwę nowego motywu:"
        THEME_SAVED="Motyw zapisany jako:"
        PREVIEW_TITLE="Podgląd motywu"
        CANCEL="Anuluj"
        REGENERATE="Wygeneruj ponownie"
        SAVE="Zapisz"
        WELCOME="Witaj, $USER"
        VERIFTXT="Skanowanie DNA..."
        WRONGTXT="ODRZUCONO DOSTĘP"
        WELCOME_="Tekst logowania"
        VERIFTXT_="Tekst weryfikacji"
        WRONGTXT_="Tekst ostrzeżenia"
        CHOOSE_TXT="Wybierz swój tekst"
        loginshadow_="Cień okna logowania"
        loginbox_="Tło okna logowania"
        transparent_="Przezroczyste tło (bez cienia)"
        font_="Czcionka"
        ringcolor_="Kolor pierścienia"
        insidecolor_="Kolor wnętrza"
        separatorcolor_="Kolor separatora"
        ringvercolor_="Kolor pierścienia weryfikacji"
        insidevercolor_="Kolor wnętrza weryfikacji"
        ringwrongcolor_="Kolor pierścienia błędu"
        insidewrongcolor_="Kolor wnętrza błędu"
        timecolor_="Kolor czasu"
        greetercolor_="Kolor powitania"
        layoutcolor_="Kolor układu"
        keyhlcolor_="Kolor podświetlenia klawisza"
        bshlcolor_="Kolor podświetlenia backspace"
        verifcolor_="Kolor weryfikacji"
        wrongcolor_="Kolor błędu"
        modifcolor_="Kolor modyfikacji"
        bgcolor_="Kolor tła"
        ;;
    es)
        TITLE="Seleccionar estilo"
        CHOOSE_STYLE="Elige un estilo de color:"
        SAVE_AS="Guardar como..."
        ENTER_NAME="Introduce el nombre del nuevo tema:"
        THEME_SAVED="Tema guardado como:"
        PREVIEW_TITLE="Vista previa del tema"
        CANCEL="Cancelar"
        REGENERATE="Regenerar"
        SAVE="Guardar"
        WELCOME="Bienvenido, $USER"
        VERIFTXT="Escaneando ADN..."
        WRONGTXT="ACCESO DENEGADO"
        WELCOME_="Texto de inicio de sesión"
        VERIFTXT_="Texto de verificación"
        WRONGTXT_="Texto de advertencia"
        CHOOSE_TXT="Elige tu texto"
        loginshadow_="Sombra del cuadro de inicio"
        loginbox_="Fondo del cuadro de inicio"
        transparent_="Fondo transparente (sin sombra)"
        font_="Fuente"
        ringcolor_="Color del anillo"
        insidecolor_="Color interior"
        separatorcolor_="Color del separador"
        ringvercolor_="Color del anillo de verificación"
        insidevercolor_="Color interior de verificación"
        ringwrongcolor_="Color del anillo de error"
        insidewrongcolor_="Color interior de error"
        timecolor_="Color de la hora"
        greetercolor_="Color del saludo"
        layoutcolor_="Color del diseño"
        keyhlcolor_="Color de resaltado de tecla"
        bshlcolor_="Color de resaltado de retroceso"
        verifcolor_="Color de verificación"
        wrongcolor_="Color de error"
        modifcolor_="Color de modificación"
        bgcolor_="Color de fondo"
        ;;
    *)
        TITLE="Choose Style"
        CHOOSE_STYLE="Select a color style:"
        SAVE_AS="Save As..."
        ENTER_NAME="Enter a name for the new theme:"
        THEME_SAVED="Theme saved as:"
        PREVIEW_TITLE="Theme Preview"
        CANCEL="Cancel"
        REGENERATE="Regenerate"
        SAVE="Save"
        WELCOME="Password for $USER"
        VERIFTXT="Scanning DNA..."
        WRONGTXT="ACCESS REJECTED"
        WELCOME_="Login Text"
        VERIFTXT_="Verify Text"
        WRONGTXT_="Warning Text"
        CHOOSE_TXT="Choose Your Text"
        loginshadow_="Login Box Shadow"
        loginbox_="Login Box Background"
        transparent_="Transparent Login Box Background (no shadow)"
        font_="Set Font"
        ringcolor_="Ring Color"
        insidecolor_="Inside Color"
        separatorcolor_="Separator Color"
        ringvercolor_="Ring Verify Color"
        insidevercolor_="Inside Verify Color"
        ringwrongcolor_="Ring Wrong Color"
        insidewrongcolor_="Inside Wrong Color"
        timecolor_="Time Color"
        greetercolor_="Greeter Color"
        layoutcolor_="Layout Color"
        keyhlcolor_="Key Highlight Color"
        bshlcolor_="Backspace Highlight Color"
        verifcolor_="Verify Color"
        wrongcolor_="Wrong Color"
        modifcolor_="Modify Color"
        bgcolor_="Background Color"
        ;;
esac

style=$(yad --list --radiolist --title="$TITLE" --text="$CHOOSE_STYLE" \
    --window-icon="$ICON" \
    --column="Select" --column="Style" TRUE "Cyberpunk" FALSE "Vibrant" FALSE "Pastel" \
    --height=250 --width=300 --center)

style=$(echo "$style" | cut -d '|' -f2)
[[ -z "$style" ]] && exit 1

random_vibrant() {
    printf "#%02x%02x%02x\n" $((RANDOM % 256)) $((RANDOM % 256)) $((RANDOM % 256))
}

random_pastel() {
    printf "#%02x%02x%02x\n" $((200 + RANDOM % 55)) $((200 + RANDOM % 55)) $((200 + RANDOM % 55))
}

random_cyberpunk() {
    local neon_colors=("#ff00ff" "#e8ff00" "#8000ff" "#86a3e1" "#00ffcc" "#ff3366" "#33ffcc")
    echo "${neon_colors[$RANDOM % ${#neon_colors[@]}]}"
}

get_color() {
    case "$style" in
        Cyberpunk) random_cyberpunk ;;
        Vibrant)   random_vibrant ;;
        Pastel)    random_pastel ;;
        *)         echo "#000000" ;;
    esac
}

text_response=$(yad --width=400 --form --title="$CHOOSE_TXT" --center \
    --window-icon="$ICON" \
    --field="$WELCOME_" "$WELCOME" \
    --field="$VERIFTXT_" "$VERIFTXT" \
    --field="$WRONGTXT_" "$WRONGTXT" \
    --button="OK:0")

IFS="|" read -r WELCOME VERIFTXT WRONGTXT <<< "$text_response"

while true; do
    for var in ringcolor insidecolor separatorcolor ringvercolor insidevercolor \
               ringwrongcolor insidewrongcolor timecolor greetercolor layoutcolor \
               keyhlcolor bshlcolor verifcolor wrongcolor modifcolor bgcolor; do
        declare "$var=$(get_color)"
    done

    loginbox="#000000"
    loginshadow="#000000"

    response=$(yad --center --form --title="$PREVIEW_TITLE ($style)" \
        --window-icon="$ICON" \
        --width=400 --height=500 \
        --button="$CANCEL:1" --button="$REGENERATE:2" --button="$SAVE:0" \
        --separator="|" \
        --field="$loginshadow_:CLR" "$loginshadow" \
        --field="$loginbox_:CLR" "$loginbox" \
        --field="$transparent_:CHK" "FALSE" \
        --field="$font_:TXT" "Ubuntu" \
        --field="$ringcolor_:CLR" "$ringcolor" \
        --field="$insidecolor_:CLR" "$insidecolor" \
        --field="$separatorcolor_:CLR" "$separatorcolor" \
        --field="$ringvercolor_:CLR" "$ringvercolor" \
        --field="$insidevercolor_:CLR" "$insidevercolor" \
        --field="$ringwrongcolor_:CLR" "$ringwrongcolor" \
        --field="$insidewrongcolor_:CLR" "$insidewrongcolor" \
        --field="$timecolor_:CLR" "$timecolor" \
        --field="$greetercolor_:CLR" "$greetercolor" \
        --field="$layoutcolor_:CLR" "$layoutcolor" \
        --field="$keyhlcolor_:CLR" "$keyhlcolor" \
        --field="$bshlcolor_:CLR" "$bshlcolor" \
        --field="$verifcolor_:CLR" "$verifcolor" \
        --field="$wrongcolor_:CLR" "$wrongcolor" \
        --field="$modifcolor_:CLR" "$modifcolor" \
        --field="$bgcolor_:CLR" "$bgcolor")

    case $? in
        1) exit 1 ;;
        2) continue ;;
        0) break ;;
    esac
done

IFS="|" read -r \
    loginshadow loginbox loginbox_trans font ringcolor insidecolor separatorcolor \
    ringvercolor insidevercolor ringwrongcolor insidewrongcolor timecolor greetercolor \
    layoutcolor keyhlcolor bshlcolor verifcolor wrongcolor modifcolor bgcolor <<< "$response"

theme_name=$(yad --center --entry --title="$SAVE_AS" --text="$ENTER_NAME" --entry-text="new-$style")
[[ -z "$theme_name" ]] && exit 1

theme_file="$THEME_DIR/${theme_name}.theme"

if [[ "$loginbox_trans" == "TRUE" ]]; then
    loginbox="00000000"
else
    loginbox="${loginbox/#\#}"
fi

cat > "$theme_file" <<EOF
loginshadow=${loginshadow/#\#}
loginbox=${loginbox}
locktext="$WELCOME"
font=${font}
ringcolor=${ringcolor/#\#}cc
insidecolor=${insidecolor/#\#}88
separatorcolor=${separatorcolor/#\#}cc
ringvercolor=${ringvercolor/#\#}ff
insidevercolor=${insidevercolor/#\#}88
ringwrongcolor=${ringwrongcolor/#\#}ff
insidewrongcolor=${insidewrongcolor/#\#}88
timecolor=${timecolor/#\#}ff
time_format=%H:%M:%S
greetercolor=${greetercolor/#\#}ff
layoutcolor=${layoutcolor/#\#}ff
keyhlcolor=${keyhlcolor/#\#}ff
bshlcolor=${bshlcolor/#\#}ff
veriftext="$VERIFTXT"
verifcolor=${verifcolor/#\#}ff
wrongtext="$WRONGTXT"
wrongcolor=${wrongcolor/#\#}ff
modifcolor=${modifcolor/#\#}ff
bgcolor=${bgcolor/#\#}ff
EOF

yad --form --title="$TITLE" --center \
    --window-icon="$ICON" \
    --text="$THEME_SAVED\n$theme_file" \
    --button="OK:0"

betterlock-themes
