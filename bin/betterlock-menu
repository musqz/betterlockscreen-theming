#!/usr/bin/env bash

ICON="system-lock-screen"
CACHE_FILE="$HOME/.cache/betterlockscreen/.betterlock-theme.txt"

command -v yad >/dev/null 2>&1 || { echo "Error: yad is not installed." >&2; exit 1; }
command -v betterlockscreen >/dev/null 2>&1 || echo "Warning: betterlockscreen not found. Some actions won't work." >&2

case "${LANG:0:2}" in
    nl)
        TITLE="Betterlockscreen Thema Manager"
        TXT_CHOOSE_ACTION="Kies een actie:"
        TXT_SELECT_THEME="Thema Kiezen"
        TXT_REGENERATE="Genereer Thema"
        TXT_HELP="Help"
        TXT_EXIT="Afsluiten"
        TXT_OK="Sluiten"
        TXT_ACTIVE_THEME="<b>Actief thema: </b>"
        TXT_HELP_TEXT="<b>[LANGZAAM PROCES] betterlockscreen -u [afbeeldingspad]:</b>\n
Werk je vergrendelingsscherm bij, inclusief achtergrond en schaduw van het inlogvak.\n
Optioneel: specificeer een aangepaste afbeelding; laat leeg om de huidige achtergrond te gebruiken.\n\n
<b>[SNEL PROCES] betterlockscreen -l:</b>\n
Bekijk direct nieuwe wijzigingen (lettertypen, kleuren) zonder achtergrond of schaduw te vernieuwen.\n\n
<b>betterlock-theme-generator:</b>\n
Maak interactief nieuwe kleurenthema's. Kies stijl, lettertype en welkomsttekst voordat je opslaat.\n\n
<b>betterlock-themes:</b>\n
Selecteer en activeer opgeslagen thema's in ~/.config/betterlockscreen/themes/.\n\n
<b>betterlock-menu:</b>\n
Start de GUI om thema's te genereren, te kiezen of het scherm te vergrendelen.\n"
        ;;
    pl)
        TITLE="Menedżer Motywów Betterlockscreen"
        TXT_CHOOSE_ACTION="Wybierz akcję:"
        TXT_SELECT_THEME="Wybierz Motyw"
        TXT_REGENERATE="Generuj Motyw"
        TXT_HELP="Pomoc"
        TXT_EXIT="Zakończ"
        TXT_OK="Zamknij"
        TXT_ACTIVE_THEME="<b>Aktywny motyw: </b>"
        TXT_HELP_TEXT="<b>[WOLNY PROCES] betterlockscreen -u [ścieżka_obrazu]:</b>\n
Aktualizuje ekran blokady, w tym tło i cień okna logowania.\n
Opcjonalnie podaj własny obraz; pozostaw puste, aby użyć bieżącej tapety.\n\n
<b>[SZYBKI PROCES] betterlockscreen -l:</b>\n
Natychmiast pokaż nowe zmiany (czcionki, kolory) bez regenerowania tła lub cienia.\n\n
<b>betterlock-theme-generator:</b>\n
Interaktywnie twórz nowe motywy kolorystyczne. Wybierz styl, czcionkę i tekst przed zapisaniem.\n\n
<b>betterlock-themes:</b>\n
Wybierz i zastosuj zapisane motywy z ~/.config/betterlockscreen/themes/.\n\n
<b>betterlock-menu:</b>\n
Uruchom GUI, aby generować motywy, wybierać motywy lub blokować ekran.\n"
        ;;
    es)
        TITLE="Betterlockscreen Gestor de Temas"
        TXT_CHOOSE_ACTION="Elige una acción:"
        TXT_SELECT_THEME="Seleccionar Tema"
        TXT_REGENERATE="Generar Tema"
        TXT_HELP="Ayuda"
        TXT_EXIT="Salir"
        TXT_OK="Cerrar"
        TXT_ACTIVE_THEME="<b>Tema activo: </b>"
        TXT_HELP_TEXT="<b>[PROCESO LENTO] betterlockscreen -u [ruta_imagen]:</b>\n
Actualiza la pantalla de bloqueo, incluyendo el fondo y la sombra del cuadro de inicio.\n
Especifica una imagen personalizada; deja vacío para usar el fondo de pantalla actual.\n\n
<b>[PROCESO RÁPIDO] betterlockscreen -l:</b>\n
Muestra instantáneamente los cambios nuevos (fuentes, colores) sin regenerar el fondo.\n\n
<b>betterlock-theme-generator:</b>\n
Crea interactivamente nuevos temas de color. Elige estilo, fuente y texto antes de guardar.\n\n
<b>betterlock-themes:</b>\n
Selecciona y aplica temas guardados en ~/.config/betterlockscreen/themes/.\n\n
<b>betterlock-menu:</b>\n
Lanza la GUI para generar temas, elegir temas o bloquear la pantalla.\n"
        ;;
    *)
        TITLE="Betterlockscreen Theme Manager"
        TXT_CHOOSE_ACTION="Choose an action:"
        TXT_SELECT_THEME="Select Theme"
        TXT_REGENERATE="Generate Theme"
        TXT_HELP="Help"
        TXT_EXIT="Exit"
        TXT_OK="Close"
        TXT_ACTIVE_THEME="<b>Active theme: </b>"
        TXT_HELP_TEXT="<b>[SLOW PROCESS] betterlockscreen -u [image_path]:</b>\n
Updates your lockscreen including loginbox background and shadow.\n
Optionally specify a custom image; leave empty to use the current wallpaper.\n\n
<b>[QUICK PROCESS] betterlockscreen -l:</b>\n
See instantly new changes (fonts, colors) without regenerating loginbox background or shadow.\n\n
<b>betterlock-theme-generator:</b>\n
Interactively create new color themes. Choose style, font, and greeter text before saving.\n\n
<b>betterlock-themes:</b>\n
Select and apply saved themes from ~/.config/betterlockscreen/themes/.\n\n
<b>betterlock-menu:</b>\n
Launch GUI to generate themes, choose themes, or lock the screen.\n"
        ;;
esac

get_header_image() {
    local cache="$HOME/.cache/betterlockscreen/current/wall_resize.png"
    local out="/tmp/yad-header.png"
    local geom w h

    geom=$(xrandr | awk '/ primary / {print $4}' | cut -d+ -f1)
    w=$(echo "$geom" | cut -dx -f1)
    h=$(echo "$geom" | cut -dx -f2)

    magick "$cache" -crop "${w}x${h}+0+0" +repage \
        -resize 350x120^ \
        -gravity center -extent 350x155 \
        "$out"

    echo "$out"
}

show_help() {
    yad --form --width=600 --height=650 --center \
        --title="$TXT_HELP" \
        --window-icon="$ICON" \
        --field="Help:TXT" "$(echo -e "$TXT_HELP_TEXT")!" \
        --button="$TXT_OK:0"
}

HEADER_IMG=$(get_header_image)

show_main_menu() {
    while true; do
        ACTIVE_THEME="$(sed 's/.*\///; s/\.[^.]*$//' "$CACHE_FILE" 2>/dev/null)"

        yad --width=350 --height=220 --center \
            --title="$TITLE" \
            --window-icon="$ICON" \
            --image="$HEADER_IMG" \
            --text="<b>$TITLE</b>\n\n$TXT_ACTIVE_THEME $ACTIVE_THEME\n\n\n$TXT_CHOOSE_ACTION" \
            --text-align=center \
            --button="🎨 $TXT_SELECT_THEME:1" \
            --button="🛠️ $TXT_REGENERATE:2" \
            --button="🛈 $TXT_HELP:3" \
            --button="🚪 $TXT_EXIT:0"

        case $? in
            1) betterlock-themes ;;
            2) betterlock-theme-generator ;;
            3) show_help ;;
            *) exit 0 ;;
        esac
    done
}

show_main_menu
