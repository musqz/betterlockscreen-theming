#!/usr/bin/env bash

THEME_DIR="$HOME/.config/betterlockscreen/themes"
OUTPUT_FILE="$HOME/.config/betterlockscreen/betterlockscreenrc"
CACHE_FILE="$HOME/.cache/betterlockscreen/.betterlock-theme.txt"
ICON="system-lock-screen"

case "${LANG:0:2}" in
    nl)
        TITLE="Afbeeldingen cachen voor snellere schermvergrendeling"
        TEXT="\nEven geduld...\ndit kan een paar seconden duren..."
        TITLE2="Klaar"
        TEXT2="Alle benodigde wijzigingen zijn toegepast.\n Gebruik <b>super + l</b> om het scherm te vergrendelen."
        CHECK_LABEL=" Vink aan voor volledige langzame definitieve update \n Laat uitgevinkt voor snelle preview (alleen lettertypen/kleuren)."
        _SELECT_THEME="Selecteer thema"
        _ERROR="Het geselecteerde thema kon niet worden gevonden!"
        _OPTIONS="Betterlockscreen-opties"
        _SELECT="Selecteer"
        _CANCEL="Annuleren"
        _THEME="Thema"
        ;;
    pl)
        TITLE="Tworzenie obrazków dla blokady ekranu"
        TEXT="\nCierpliwości...\nto może chwilkę potrwać..."
        TITLE2="Gotowe"
        TEXT2="Wszystkie zmiany zostały zastosowane.\n Użyj <b>super + l</b>, aby zablokować ekran."
        CHECK_LABEL=" Zaznacz, aby wykonać pełną, wolną aktualizację końcową \n Pozostaw niezaznaczone, aby uzyskać szybki podgląd (tylko czcionki/kolory)."
        _SELECT_THEME="Wybierz motyw"
        _ERROR="Nie można znaleźć wybranego motywu!"
        _OPTIONS="Opcje Betterlockscreen"
        _SELECT="Wybierz"
        _CANCEL="Anuluj"
        _THEME="Motyw"
        ;;
    es)
        TITLE="Generando imágenes para el bloqueo de pantalla"
        TEXT="\nPor favor espera...\nesto puede tardar unos segundos..."
        TITLE2="Listo"
        TEXT2="Todos los cambios se han aplicado.\n Usa <b>super + l</b> para bloquear la pantalla."
        CHECK_LABEL=" Marca la casilla para actualización final lenta completa \n Déjalo sin marcar para vista previa rápida (solo fuentes/colores)."
        _SELECT_THEME="Seleccionar tema"
        _ERROR="¡El tema seleccionado no se pudo encontrar!"
        _OPTIONS="Opciones de Betterlockscreen"
        _SELECT="Seleccionar"
        _CANCEL="Cancelar"
        _THEME="Tema"
        ;;
    *)
        TITLE="Caching images for faster screen locking"
        TEXT="\nPlease wait...\nthis might take a few seconds..."
        TITLE2="Done"
        TEXT2="All required changes have been applied.\n Use <b>super + l</b> to lock screen."
        CHECK_LABEL=" Check the box for full slow final update \n leave unchecked for quick preview (fonts/colors only)."
        _SELECT_THEME="Select Theme"
        _ERROR="The selected theme could not be found!"
        _OPTIONS="Betterlockscreen Options"
        _SELECT="Select"
        _CANCEL="Cancel"
        _THEME="Theme"
        ;;
esac

mapfile -t THEMES < <(find "$THEME_DIR" -maxdepth 1 -type f -name "*.theme" -exec basename {} .theme \; | sort)

SELECTED=$(yad --list \
    --window-icon="$ICON" \
    --title="$_SELECT_THEME" \
    --width=400 --height=300 \
    --column="$_THEME" "${THEMES[@]}" \
    --separator="" \
    --center \
    --button="$_SELECT:0" --button="$_CANCEL:1")

[[ $? -ne 0 || -z "$SELECTED" ]] && exit 1

SELECTED_FILE="$THEME_DIR/$SELECTED.theme"

save_name() {
    mkdir -p "$(dirname "$CACHE_FILE")"
    echo "$SELECTED_FILE" > "$CACHE_FILE"
}

DO_UPDATE=$(yad --form \
    --window-icon="$ICON" \
    --title="$_OPTIONS" \
    --center \
    --field="$CHECK_LABEL:CHK" FALSE \
    --field="Custom Background Path:FL" "" \
    --separator="|" \
    --button="OK:0" --button="$_CANCEL:1" \
    --width=500 \
    --height=100 \
    --align=center)

[[ $? -ne 0 ]] && exit 1

UPDATE_IMAGE=$(echo "$DO_UPDATE" | cut -d"|" -f1)
CUSTOM_BG=$(echo "$DO_UPDATE" | cut -d"|" -f2)

save_name

if [[ -f "$SELECTED_FILE" ]]; then
    cp "$SELECTED_FILE" "$OUTPUT_FILE"

    if [[ "$UPDATE_IMAGE" == "TRUE" ]]; then
        if [[ -n "$CUSTOM_BG" && -f "$CUSTOM_BG" ]]; then
            BG_PATH="$CUSTOM_BG"
        else
            BG_PATH=$(grep '^file=' ~/.config/nitrogen/bg-saved.cfg 2>/dev/null | cut -d= -f2-)
        fi

        if [[ -z "$BG_PATH" ]]; then
            yad --error --text="No background image found. Specify a custom path." --center --timeout=4
            exit 1
        fi

        notify-send -u critical -i emblem-photos "$TITLE" "$TEXT"
        betterlockscreen -u "$BG_PATH"
        notify-send -u normal -i emblem-photos "$TITLE2" "$TEXT2"
    fi

    betterlockscreen -l
else
    yad --error --text="$_ERROR" --center --timeout=3
    exit 1
fi
